<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.slim.agent.mapper.StudentCourseMapper">

    <resultMap id="BaseResultMap" type="com.slim.agent.entity.StudentCourse">
        <id column="id" property="id"/>
        <result column="student_id" property="studentId"/>
        <result column="day_of_week" property="dayOfWeek"/>
        <result column="period_number" property="periodNumber"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, student_id, day_of_week, period_number
    </sql>

    <insert id="insert" parameterType="com.slim.agent.entity.StudentCourse" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO student_courses (student_id, day_of_week, period_number)
        VALUES (#{studentId}, #{dayOfWeek}, #{periodNumber})
    </insert>

    <delete id="deleteById">
        DELETE FROM student_courses WHERE id = #{id}
    </delete>

    <delete id="deleteByStudentId">
        DELETE FROM student_courses WHERE student_id = #{studentId}
    </delete>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/> FROM student_courses WHERE id = #{id}
    </select>

    <select id="selectAll" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/> FROM student_courses
    </select>

    <select id="selectByStudentId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/> FROM student_courses WHERE student_id = #{studentId}
    </select>

    <select id="selectByStudentIdAndDayOfWeek" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/> FROM student_courses
        WHERE student_id = #{studentId} AND day_of_week = #{dayOfWeek}
    </select>

</mapper>
